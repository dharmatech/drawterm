# Native Windows build with Microsoft Visual C.
# Run from an x64 Visual Studio developer shell:
#     nmake /f NMakefile.msvc

BUILD=build\msvc
TARG=$(BUILD)\drawterm.exe

CC=cl
LINK=link
LIBTOOL=lib
RC=rc

CFLAGS=/nologo /c /utf-8 /std:c17 /W3 /O2 /MT /DWIN32_LEAN_AND_MEAN /DNOMINMAX /DWINDOWS /DUNICODE /DMSVC /D_CRT_SECURE_NO_WARNINGS /D_CRT_SECURE_NO_DEPRECATE /D_CRT_NONSTDC_NO_WARNINGS /D_CRT_NONSTDC_NO_DEPRECATE /D_WINSOCK_DEPRECATED_NO_WARNINGS /Iinclude /I. /Ikern
LINKFLAGS=/nologo /SUBSYSTEM:WINDOWS /OUT:$(TARG)
SYSLIBS=kernel32.lib user32.lib gdi32.lib advapi32.lib shell32.lib ws2_32.lib winmm.lib mpr.lib

ROOTOBJ=$(BUILD)\root
KERNOBJ=$(BUILD)\kern
EXPORTFSOBJ=$(BUILD)\exportfs
LIBAUTHOBJ=$(BUILD)\libauth
LIBAUTHSRVOBJ=$(BUILD)\libauthsrv
LIBSECOBJ=$(BUILD)\libsec
LIBMPOBJ=$(BUILD)\libmp
LIBMEMDRAWOBJ=$(BUILD)\libmemdraw
LIBMEMLAYEROBJ=$(BUILD)\libmemlayer
LIBDRAWOBJ=$(BUILD)\libdraw
GUIOBJ=$(BUILD)\gui-win32
LIBCOBJ=$(BUILD)\libc
LIBIPOBJ=$(BUILD)\libip
MACHOBJ=$(BUILD)\posix-port

KERN_LIB=$(BUILD)\libkern.lib
EXPORTFS_LIB=$(BUILD)\libexportfs.lib
LIBAUTH_LIB=$(BUILD)\libauth.lib
LIBAUTHSRV_LIB=$(BUILD)\libauthsrv.lib
LIBSEC_LIB=$(BUILD)\libsec.lib
LIBMP_LIB=$(BUILD)\libmp.lib
LIBMEMDRAW_LIB=$(BUILD)\libmemdraw.lib
LIBMEMLAYER_LIB=$(BUILD)\libmemlayer.lib
LIBDRAW_LIB=$(BUILD)\libdraw.lib
GUI_LIB=$(BUILD)\libgui.lib
LIBC_LIB=$(BUILD)\libc.lib
LIBIP_LIB=$(BUILD)\libip.lib
MACH_LIB=$(BUILD)\libmachdep.lib

LIBS=\
	$(KERN_LIB)\
	$(EXPORTFS_LIB)\
	$(LIBAUTH_LIB)\
	$(LIBAUTHSRV_LIB)\
	$(LIBSEC_LIB)\
	$(LIBMP_LIB)\
	$(LIBMEMDRAW_LIB)\
	$(LIBMEMLAYER_LIB)\
	$(LIBDRAW_LIB)\
	$(GUI_LIB)\
	$(LIBC_LIB)\
	$(LIBIP_LIB)\
	$(MACH_LIB)

