RES=$(BUILD)\glenda-t.res

all: dirs $(TARG)

dirs:
	@if not exist "$(BUILD)" mkdir "$(BUILD)"
	@if not exist "$(ROOTOBJ)" mkdir "$(ROOTOBJ)"
	@if not exist "$(KERNOBJ)" mkdir "$(KERNOBJ)"
	@if not exist "$(EXPORTFSOBJ)" mkdir "$(EXPORTFSOBJ)"
	@if not exist "$(LIBAUTHOBJ)" mkdir "$(LIBAUTHOBJ)"
	@if not exist "$(LIBAUTHSRVOBJ)" mkdir "$(LIBAUTHSRVOBJ)"
	@if not exist "$(LIBSECOBJ)" mkdir "$(LIBSECOBJ)"
	@if not exist "$(LIBMPOBJ)" mkdir "$(LIBMPOBJ)"
	@if not exist "$(LIBMEMDRAWOBJ)" mkdir "$(LIBMEMDRAWOBJ)"
	@if not exist "$(LIBMEMLAYEROBJ)" mkdir "$(LIBMEMLAYEROBJ)"
	@if not exist "$(LIBDRAWOBJ)" mkdir "$(LIBDRAWOBJ)"
	@if not exist "$(GUIOBJ)" mkdir "$(GUIOBJ)"
	@if not exist "$(LIBCOBJ)" mkdir "$(LIBCOBJ)"
	@if not exist "$(LIBIPOBJ)" mkdir "$(LIBIPOBJ)"
	@if not exist "$(MACHOBJ)" mkdir "$(MACHOBJ)"

$(TARG): dirs $(ROOT_OBJS) $(LIBS) $(RES)
	$(LINK) $(LINKFLAGS) $(ROOT_OBJS) $(LIBS) $(LIBS) $(RES) $(SYSLIBS)

$(KERN_LIB): dirs $(KERN_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(KERN_OBJS)

$(EXPORTFS_LIB): dirs $(EXPORTFS_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(EXPORTFS_OBJS)

$(LIBAUTH_LIB): dirs $(LIBAUTH_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBAUTH_OBJS)

$(LIBAUTHSRV_LIB): dirs $(LIBAUTHSRV_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBAUTHSRV_OBJS)

$(LIBSEC_LIB): dirs $(LIBSEC_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBSEC_OBJS)

$(LIBMP_LIB): dirs $(LIBMP_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBMP_OBJS)

$(LIBMEMDRAW_LIB): dirs $(LIBMEMDRAW_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBMEMDRAW_OBJS)

$(LIBMEMLAYER_LIB): dirs $(LIBMEMLAYER_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBMEMLAYER_OBJS)

$(LIBDRAW_LIB): dirs $(LIBDRAW_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBDRAW_OBJS)

$(GUI_LIB): dirs $(GUI_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(GUI_OBJS)

$(LIBC_LIB): dirs $(LIBC_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBC_OBJS)

$(LIBIP_LIB): dirs $(LIBIP_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(LIBIP_OBJS)

$(MACH_LIB): dirs $(MACH_OBJS)
	$(LIBTOOL) /nologo /OUT:$@ $(MACH_OBJS)

$(RES): glenda-t.rc glenda-t.ico
	$(RC) /nologo /fo$@ glenda-t.rc

{.}.c{$(ROOTOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{kern}.c{$(KERNOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{exportfs}.c{$(EXPORTFSOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libauth}.c{$(LIBAUTHOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libauthsrv}.c{$(LIBAUTHSRVOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libsec}.c{$(LIBSECOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libmp}.c{$(LIBMPOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libmemdraw}.c{$(LIBMEMDRAWOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libmemlayer}.c{$(LIBMEMLAYEROBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libdraw}.c{$(LIBDRAWOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{gui-win32}.c{$(GUIOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libc}.c{$(LIBCOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{libip}.c{$(LIBIPOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

{posix-port}.c{$(MACHOBJ)}.obj:
	$(CC) $(CFLAGS) /Fo$@ $<

clean:
	@if exist "$(BUILD)" rmdir /s /q "$(BUILD)"
